# ============================================================
# AlphaDate Personal AI - Environment Configuration Example
# Copy this file to .env in packages/local-app (do NOT commit .env)
# ============================================================

# Local Application Server
LOCAL_APP_HOST=127.0.0.1
LOCAL_APP_PORT=4789
LOCAL_APP_WS_PORT=4790
LOCAL_APP_SECRET_TOKEN=generate-a-secure-random-token-here

# SQLite Database Location
SQLITE_DB_PATH=./data/alphadate.sqlite

# AI Model Providers (Configure only what you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local LLM Support (Ollama / LM Studio on Windows)
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3:8b

# Logging & Debugging
LOG_LEVEL=info
DEBUG_AI_REQUESTS=false
